# Copy to .env and adjust. Never commit .env.

NODE_ENV=development
PORT=3000

# PostgreSQL connection string. Local default matches docker-compose.yml.
DATABASE_URL=postgresql://ecoplus:ecoplus@localhost:5432/ecoplus_dev

# Secret used to sign access tokens. At least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-me-with-a-long-random-secret-value

# Access token lifetime (for example 15m) and refresh token lifetime in days.
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=30

# Comma separated list of browser origins allowed to call the API (Flutter Web).
CORS_ORIGINS=http://localhost:8080

# Requests allowed per minute per IP, and the stricter limit for login and register.
THROTTLE_LIMIT=120
AUTH_THROTTLE_LIMIT=10

# Pickup decision rule: minimum fill level (0 to 1) for a bag to be collected.
READY_FILL_THRESHOLD=0.6
BUSINESS_READY_FILL_THRESHOLD=0.4

# Decision rule v2: collect a bag at least MERGE_MIN_FILL full when another open shipment is within MERGE_RADIUS_M metres.
MERGE_RADIUS_M=150
MERGE_MIN_FILL=0.3

# Optional: Google Routes API key for stop ordering. Empty = nearest-neighbour ordering.
GOOGLE_ROUTES_API_KEY=

# Time zone that decides what "today" means for a driver.
APP_TIMEZONE=Africa/Cairo

# Push notifications: none or log (a real FCM sender is not built yet).
PUSH_PROVIDER=none

# Where uploaded bag photos are stored (local disk for development) and the size limit in MB.
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5

# Serve Swagger UI at /docs. Keep false in production.
SWAGGER_ENABLED=true
