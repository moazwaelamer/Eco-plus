{
  "typescript.tsdk": "apps/backend/node_modules/typescript/lib",
  "typescript.preferences.importModuleSpecifierEnding": "js",
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnSave": true,
  "[prisma]": { "editor.defaultFormatter": "Prisma.prisma" },
  "files.exclude": { "**/dist": true, "**/*.tsbuildinfo": true },
  "search.exclude": { "**/dist": true, "apps/backend/src/generated": true, "package-lock.json": true },
  "files.watcherExclude": { "**/node_modules/**": true, "**/dist/**": true, "**/uploads/**": true },
  "vitest.rootConfig": "apps/backend/vitest.config.ts"
}
